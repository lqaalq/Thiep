<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <title>GỬI AIU</title>

    <style>
      body {
        background: pink;
        overflow: hidden;
        transition: background 1s;
      }

      /* nền khi mở thiệp */
      body.opened {
        background: #ff7aa8;
      }

      /* icon bay */
      .icon {
        position: fixed;
        bottom: -20px;
        font-size: 26px;
        animation: bay 7s linear infinite;
      }

      /* trái cây ẩn */
      .fruit {
        display: none;
      }

      /* mở thiệp thì hiện */
      body.opened .fruit {
        display: block;
      }

      @keyframes bay {
        0% {
          transform: translateY(0);
          opacity: 1;
        }
        100% {
          transform: translateY(-900px);
          opacity: 0;
        }
      }

      /* vị trí icon */
      .icon:nth-child(1) {
        left: 10%;
        animation-duration: 6s;
      }
      .icon:nth-child(2) {
        left: 25%;
        animation-duration: 8s;
      }
      .icon:nth-child(3) {
        left: 40%;
        animation-duration: 7s;
      }
      .icon:nth-child(4) {
        left: 55%;
        animation-duration: 6s;
      }
      .icon:nth-child(5) {
        left: 70%;
        animation-duration: 9s;
      }
      .icon:nth-child(6) {
        left: 85%;
        animation-duration: 7s;
      }

      /* hiệu ứng lật thiệp */

      .flip-card {
        perspective: 1000px;
      }

      .flip-inner {
        position: relative;
        width: 100%;
        transition: transform 0.8s;
        transform-style: preserve-3d;
      }

      .flip-card.flip .flip-inner {
        transform: rotateY(180deg);
      }

      .flip-front,
      .flip-back {
        position: absolute;
        width: 100%;
        backface-visibility: hidden;
      }

      .flip-back {
        transform: rotateY(180deg);
      }

      /* sticker GIF */

      .sticker-gif {
        position: fixed;
        bottom: 10px;
        width: 300px;
        z-index: 1000;
        display: none;
        animation: nhay 1.5s infinite;
      }

      /* hiện khi mở thiệp */
      body.opened .sticker-gif {
        display: block;
      }

      .sticker-left {
        left: 100px;
      }

      .sticker-right {
        right: 100px;
      }

      @keyframes nhay {
        0% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
        100% {
          transform: translateY(0);
        }
      }
    </style>
  </head>

  <body class="text-center mt-5">
    <!-- tim bay -->
    <div class="icon">❤</div>
    <div class="icon">❤</div>

    <!-- trái cây -->
    <div class="icon fruit">🍒</div>
    <div class="icon fruit">🫐</div>
    <div class="icon fruit">🍒</div>
    <div class="icon fruit">🫐</div>

    <button class="btn btn-success" onclick="hienThiep()">
      click zô đây ik
    </button>

    <!-- thiệp -->

    <div
      id="thiep"
      class="card mx-auto mt-4 flip-card"
      style="width: 350px; display: none"
    >
      <div class="flip-inner">
        <div class="flip-front">
          <img src="qavh.jpg" class="card-img-top" onclick="latThiep()" />

          <div class="card-body">
            <h5 class="card-title">Chúc aiu ngày 14/3 vui vẻ nhoa 🎉</h5>

            <p class="card-text">ai lớp diu!</p>
          </div>
        </div>

        <div class="flip-back card-body">
          <h4>💌 GỬI ANH IU NE</h4>

          <p>
            Chúc vịt quất nhỏ 🫐 cụa em có một ngày 14/3 thật vui vẻ và nhiều
            niềm vui nhe. Cảm ơn aiu vì đã đến bên em và luôn ở cạnh em. Hy vọng
            rằng chúng ta sẽ luôn yêu thương nhau thật nhiều, cùng nhau tạo ra
            thật nhiều kỷ niệm đẹp trong những ngày sắp tới. Chúc aiu lúc nào
            cũng vui vẻ, hạnh phúc và luôn ở bên em thật lâu nha. 💌🫐❤
          </p>
        </div>
      </div>
    </div>

    <!-- sticker GIF -->

    <img
      class="sticker-gif sticker-left"
      src="https://anhtomau.com/wp-content/uploads/2025/12/Sticker-anh-dong-dang-yeu.gif"
    />

    <img
      class="sticker-gif sticker-right"
      src="https://anhtomau.com/wp-content/uploads/2025/12/Sticker-anh-dong-trend.gif"
    />

    <script>
      function hienThiep() {
        document.getElementById("thiep").style.display = "block";
        document.body.classList.add("opened");
      }

      function latThiep() {
        document.getElementById("thiep").classList.toggle("flip");
      }
    </script>
  </body>
</html>
